{
  "name": "zagrev/dmbc-extras",
  "description": "WordPress plugin for the Dayton Metro Barbershop Chorus.",
  "type": "wordpress-plugin",
  "license": "CC-BY-NC-ND-4.0",
  "require": {
    "yahnis-elsts/plugin-update-checker": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "DmbcExtras\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require-dev": {
    "antecedent/patchwork": "^2.2",
    "brain/monkey": "^2.7",
    "phpunit/phpunit": "^13.2",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-cli/wp-cli": "^2.12",
    "wp-coding-standards/wpcs": "^3.4"
  }
}
